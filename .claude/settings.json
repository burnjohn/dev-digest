{
 "permissions": {
    "deny": [
      "Edit(/.claude/settings*.json)",
      "Edit(/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pr-gate.mjs"
          }
        ]
      }
    ]
  },
  "env": {
		"ENABLE_TOOL_SEARCH": "true"
  }
}
