node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
reports/
.stryker-tmp/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# nested git worktrees for parallel feature branches (local)
.worktrees/

# Claude local settings
.claude/settings.local.json
.claude/settings.json

# vscode local settings
.vscode/settings.json

# skill-creator eval run output (disposable — skill-evals/<skill>/evals.json and fixtures/ are
# committed, run artifacts are not). Convention: run output for a project skill's with/without or
# old/new comparison goes in skill-evals/<skill>/outputs/<skill-name>-v-N/ — never
# <skill-name>-workspace/. N is per-skill, starting at 2 for that skill's first comparison round;
# a second round for the SAME skill later takes v-3, a third v-4, etc. Different skills each start
# their own count at v-2 independently.
skill-evals/*/outputs/
