node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review verdicts, cache and PR drafts — machine-local and sha-bound.
# baseline.json and false-positives.md are team knowledge and ARE committed.
.claude/pr-review/*
!.claude/pr-review/baseline.json
!.claude/pr-review/false-positives.md
