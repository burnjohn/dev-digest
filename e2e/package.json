{
  "name": "@devdigest/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic browser e2e for the DevDigest web app, driven by Vercel agent-browser (CDP, no LLM).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx run.ts",
    "e2e:hermetic": "../scripts/e2e.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && npm run lint:flows",
    "lint:flows": "! grep -rn '\"chat\"' specs/ || (echo 'ERROR: the AI chat command is banned in flows — deterministic locators only (AGENTS.md).' && false)",
    "format": "prettier --write . --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --config ../.prettierrc.json --ignore-path ../.prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}
